# Copia este archivo a .env (está en .gitignore) y completa la credencial.
# Docker Compose lee .env automáticamente; la credencial solo llega al
# servicio `agent` y nunca al portal ni al navegador.
#
#   cp .env.example .env
#   docker compose up -d --build agent portal

# -- Proveedor del modelo -------------------------------------------------------
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5-5
# Clave de la API de Anthropic (formato sk-ant-...). Vacía = el chat informa
# que el agente requiere configuración; el resto del sistema funciona igual.
ANTHROPIC_API_KEY=
# Esfuerzo de razonamiento: low | medium | high | xhigh | max.
AGENT_EFFORT=low
# Fallback del servidor si el modelo declina responder (true | false).
AGENT_REFUSAL_FALLBACK=true

# -- Límites del chat --------------------------------------------------------------
AGENT_REQUEST_TIMEOUT_S=60
AGENT_MODEL_TIMEOUT_S=30
AGENT_MAX_CONCURRENT_CHATS=4
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_QUESTION_CHARS=500
AGENT_MAX_TOOL_ITEMS=25
# Zona horaria IANA en que el asistente presenta las fechas (datos en UTC).
AGENT_DISPLAY_TIMEZONE=America/Bogota

# -- Llamadas del agente a la API de flota -------------------------------------------
FLEET_CONNECT_TIMEOUT_S=2
FLEET_READ_TIMEOUT_S=6
FLEET_RETRIES=2
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_S=30
CB_HALF_OPEN_MAX_CALLS=1
